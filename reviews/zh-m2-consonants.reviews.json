          "scenario": "Tongue-twister practice.",
          "questions": [
            {
              "type": "mcq",
              "prompt": "In *De Ofe isch offe*, what changes between Ofe and offe?",
              "options": [
                "The f is held longer in offe",
                "The vowel changes from o to u",
                "Ofe has a puff of air",
                "Nothing; they sound the same"
              ],
              "answer": 0,
              "explanation": "Soft vs strong f."
            },
            {
              "type": "mcq",
              "prompt": "Which word is the classic test word?",
              "options": [
                "Grüezi",
                "Chuchichäschtli",
                "Velo",
                "Märt"
              ],
              "answer": 1,
              "explanation": "Three ch's and a scht."
            },
            {
              "type": "self-check",
              "prompt": "Say the Papscht tongue twister slowly, then name two rules it trains.",
              "modelAnswer": "De Papscht hät z Spiez s Späckbsteck z spaat bstellt. It trains schp and scht in every position, plus the open ä and long aa."
            }
          ]
        },
        {
          "id": "ex2",
          "kind": "connect",
          "scenario": "You hear *viu* and *vil* from two people.",
          "questions": [
            {
              "type": "mcq",
              "prompt": "Which is Zurich?",
              "options": [
                "viu",
                "both",
                "vil",
                "neither"
              ],
              "answer": 2,
              "explanation": "Clear l."
            },
            {
              "type": "mcq",
              "prompt": "A tea order should sound like?",
              "options": [
                "En Tee, bitte, with a strong puff after t",
                "Ein Tee, bitte schön, in High German",
                "En Dee, bidde, fully voiced",
                "En Tee, bitte, with no puff after t"
              ],
              "answer": 3,
              "explanation": "Unaspirated t."
            }
          ]
        }
      ]
    },
    {
      "id": "rv-zh2-m",
