  "units": [
    {
      "id": "rv-zh2-l01",
      "level": "lesson",
      "covers": [
        "zh2-l01-ch"
      ],
      "summary": {
        "title": "The throaty ch",
        "points": [
          "Zurich has one ch: the throaty Bach sound, also in ich.",
          "Initial k in native words becomes ch: Chind, Chuchi, Chäs, chalt.",
          "Chile = church; zue = closed.",
          "Chind is singular and plural."
        ]
      },
      "exercises": [
        {
          "id": "ex1",
          "kind": "apply",
          "scenario": "You're at home with the family.",
          "questions": [
            {
              "type": "mcq",
              "prompt": "'The children are in the kitchen' is?",
              "options": [
                "D Chind sind i de Chuchi.",
                "Die Kinder sind in der Küche.",
                "D Kind sind i de Kuchi.",
                "D Chinder isch i de Chuchi."
              ],
              "answer": 0,
              "explanation": "Chind (plural), Chuchi."
            },
            {
              "type": "mcq",
              "prompt": "'It's cold today' is?",
              "options": [
                "Es isch kalt hüt.",
                "Es isch chalt hüt.",
                "Es ist chalt heute.",
                "Es isch chalt hüüt."
              ],
              "answer": 1,
              "explanation": "k → ch; short hüt."
            }
          ]
        },
        {
          "id": "ex2",
          "kind": "connect",
          "scenario": "You compare High German and Zurich ich.",
          "questions": [
            {
              "type": "mcq",
              "prompt": "What's different?",
              "options": [
                "Zurich drops the ch completely",
                "Zurich uses a k sound",
                "Zurich uses the throaty Bach sound",
                "Nothing at all"
              ],
              "answer": 2,
              "explanation": "No soft ich-sound in Zurich."
            },
            {
              "type": "mcq",
              "prompt": "What does *D Chile isch zue* mean?",
              "options": [
                "The country is far away.",
                "The cheese is in the fridge.",
                "The kitchen door is open.",
                "The church is closed."
              ],
              "answer": 3,
              "explanation": "Chile = Kirche."
            }
          ]
        }
      ]
    },
    {
      "id": "rv-zh2-l02",
      "level": "lesson",
      "covers": [
        "zh2-l02-k-loanwords"
      ],
      "summary": {
        "title": "k, kch and gg",
        "points": [
          "Loanwords keep a strong kch [kx]: Kafi, Kino, Kilo, Konzärt.",
          "Native initial k becomes ch; kei (kein) keeps k.",
          "gg inside words is a strong, held k: Rugge, Glogge, Brugg.",
          "Öpfel = Äpfel."
        ]
      },
      "exercises": [
        {
          "id": "ex1",
          "kind": "apply",
          "scenario": "At a café and then the cinema.",
          "questions": [
            {
              "type": "mcq",
              "prompt": "How do you order a coffee with cream?",
              "options": [
                "En Kafi Creme",
                "En Chafi Creme",
                "Einen Kaffee mit Rahm",
                "Es Kafi Chreme"
              ],
              "answer": 0,
              "explanation": "Loanword: k stays."
            },
            {
              "type": "mcq",
              "prompt": "'We're going to the cinema' is?",
              "options": [
                "Mir gönd is Chino.",
                "Mir gönd is Kino.",
                "Wir gehen ins Kino.",
                "Mir gaan is Kino."
              ],
              "answer": 1,
              "explanation": "Kino keeps its k."
            }
          ]
        },
        {
          "id": "ex2",
          "kind": "connect",
          "scenario": "Your back hurts after gardening.",
          "questions": [
            {
              "type": "mcq",
              "prompt": "What do you say?",
              "options": [
                "Mir tuet de Rücke weh.",
                "Mir tut der Rücken weh.",
                "Mir tuet de Rugge weh.",
                "Mir tuet de Ruche weh."
              ],
              "answer": 2,
              "explanation": "Rücken → Rugge."
            },
            {
              "type": "mcq",
              "prompt": "How is the gg in Rugge said?",
              "options": [
                "A voiced g as in English 'go'",
                "A throaty ch",
                "It isn't pronounced",
                "A strong, held k"
              ],
              "answer": 3,
              "explanation": "gg = fortis k."
            }
          ]
        }
      ]
    },
    {
      "id": "rv-zh2-l03",
      "level": "lesson",
      "covers": [
        "zh2-l03-scht"
      ],
      "summary": {
        "title": "scht and schp everywhere",
        "points": [
          "Zurich says scht and schp in every position, not just at the start.",
          "isch, Poscht, Wurscht, geschter, Durscht, Fäscht.",
          "This course writes scht in the middle and at the end; st/sp at the start.",
          "Das isch mer Wurscht = I don't care."
        ]
      },
      "exercises": [
        {
          "id": "ex1",
          "kind": "apply",
          "scenario": "Errands and evenings.",
          "questions": [
            {
              "type": "mcq",
              "prompt": "'I'm going to the post office' is?",
              "options": [
                "Ich gaa uf d Poscht.",
                "Ich gaa uf d Post.",
                "Ich gehe zur Post.",
                "Ich gaa is Poscht."
              ],
              "answer": 0,
              "explanation": "Post → Poscht."
            },
            {
              "type": "mcq",
              "prompt": "'I'm thirsty' is?",
              "options": [
                "Ich ha Durst.",
                "Ich ha Durscht.",
                "Ich habe Durst.",
                "Ich bi Durscht."
              ],
              "answer": 1,
              "explanation": "st → scht."
            }
          ]
        },
        {
          "id": "ex2",
          "kind": "connect",
          "scenario": "A friend shrugs: *Das isch mer Wurscht.*",
          "questions": [
            {
              "type": "mcq",
              "prompt": "What does she mean?",
              "options": [
                "She wants a sausage for lunch",
                "She feels sick",
                "She doesn't care",
                "She thinks it's the worst idea"
              ],
              "answer": 2,
              "explanation": "Same idiom as High German."
            },
            {
              "type": "mcq",
              "prompt": "How is the written *sp* in *spöter* said?",
              "options": [
                "sp, exactly as written",
                "sch only, without p",
                "ps",
                "schp"
              ],
              "answer": 3,
              "explanation": "Initial sp is said schp."
            }
          ]
        }
      ]
    },
    {
      "id": "rv-zh2-l04",
      "level": "lesson",
      "covers": [
        "zh2-l04-soft-strong"
      ],
      "summary": {
        "title": "Soft and strong consonants",
        "points": [
          "b, d, g are soft and unvoiced; p, t, k are stronger and longer.",
          "No puff of air after p, t, k.",
          "Ofe (oven) vs offe (open): soft vs held f.",
          "Words run together with no stop before vowels: Es isch alles in Ornig."
        ]
      },
      "exercises": [
        {
          "id": "ex1",
          "kind": "apply",
          "scenario": "Morning in the kitchen.",
          "questions": [
            {
              "type": "mcq",
              "prompt": "'The door is open' is?",
              "options": [
                "D Tür isch offe.",
                "D Tür isch Ofe.",
                "Die Tür ist offen.",
                "D Tür isch zue."
              ],
              "answer": 0,
              "explanation": "offe = open; zue = closed."
            },
            {
              "type": "mcq",
              "prompt": "How do you say *Guete Morge*'s g?",
              "options": [
                "Voiced, like English 'good'",
                "Soft, without voice buzz",
                "Like a throaty ch",
                "With a strong puff of air"
              ],
              "answer": 1,
              "explanation": "Lenis g."
            }
          ]
        },
        {
          "id": "ex2",
          "kind": "connect",
          "scenario": "Someone asks if everything is OK.",
          "questions": [
            {
              "type": "mcq",
              "prompt": "What's the reassuring answer?",
              "options": [
                "Es ist alles in Ordnung.",
                "Es isch alles Ornig gsii.",
                "Es isch alles in Ornig.",
                "Alles isch in Ordnig gange."
              ],
              "answer": 2,
              "explanation": "Ornig = Ordnung."
            },
            {
              "type": "mcq",
              "prompt": "How should it sound?",
              "options": [
                "With a clear stop before alles and in",
                "Word by word",
                "With strong puffs after each t",
                "One flowing line"
              ],
              "answer": 3,
              "explanation": "No glottal stops."
            }
          ]
        }
      ]
    },
    {
      "id": "rv-zh2-l05",
      "level": "lesson",
      "covers": [
        "zh2-l05-r-l"
      ],
      "summary": {
        "title": "r and l",
        "points": [
          "Both rolled and throaty r are normal in Zurich.",
          "Final -er stays a short er.",
          "Zurich keeps a clear l: Milch, vil.",
          "Bern turns l into a u-like sound: Miuch, viu."
        ]
      },
      "exercises": [
        {
          "id": "ex1",
          "kind": "apply",
          "scenario": "A rainy morning.",
          "questions": [
            {
              "type": "mcq",
              "prompt": "'It's raining' is?",
              "options": [
                "Es rägnet.",
                "Es regnet.",
                "Es rägnet gsii.",
                "Es isch rägne."
              ],
              "answer": 0,
              "explanation": "Open ä."
            },
            {
              "type": "mcq",
              "prompt": "'Good luck!' is?",
              "options": [
                "Viu Glück!",
                "Vil Glück!",
                "Viel Glück!",
                "Vill Glüch!"
              ],
              "answer": 1,
              "explanation": "Clear l, short i."
            }
          ]
        },
        {
          "id": "ex2",
          "kind": "connect",
          "scenario": "A colleague says *Ich hol d Miuch*.",
          "questions": [
            {
              "type": "mcq",
              "prompt": "What does that tell you?",
              "options": [
                "She's mispronouncing Zurich German",
                "She's speaking High German",
                "She probably speaks Bern German",
                "She's from Basel"
              ],
              "answer": 2,
              "explanation": "u-like l is Bern."
            },
            {
              "type": "mcq",
              "prompt": "Which r should you use?",
              "options": [
                "Only the rolled tongue-tip r",
                "Only the throaty back r",
                "No r at all",
                "Whichever comes naturally"
              ],
              "answer": 3,
              "explanation": "Both are normal."
            }
          ]
        }
      ]
    },
    {
      "id": "rv-zh2-b1",
