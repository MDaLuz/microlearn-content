        "zh2-l06-recap"
      ],
      "summary": {
        "title": "Soft, strong, r and l",
        "points": [
          "Soft vs strong consonants differ by length and pressure, not voicing.",
          "No puff of air; words flow together.",
          "Clear l in Zurich; Bern has a u-like l.",
          "Rolled or throaty r both fine; tongue twisters train all of it."
        ]
      },
      "exercises": [
        {
          "id": "ex1",
