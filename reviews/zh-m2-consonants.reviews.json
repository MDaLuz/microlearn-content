          "questions": [
            {
              "type": "mcq",
              "prompt": "'The church is closed' is?",
              "options": [
                "D Chile isch zue.",
                "D Kirche isch zue.",
                "D Chile isch offe.",
                "Die Kirche ist zu."
              ],
              "answer": 0,
              "explanation": "Chile, zue."
            },
            {
              "type": "mcq",
              "prompt": "'I have a headache' is?",
              "options": [
                "Ich ha Kopfweh.",
                "Ich ha Chopfweh.",
                "Ich habe Kopfweh.",
                "Ich bi Chopfweh."
              ],
              "answer": 1,
              "explanation": "k → ch."
            },
            {
              "type": "mcq",
              "prompt": "'Everything's fine' is?",
              "options": [
                "Es ist alles in Ordnung.",
