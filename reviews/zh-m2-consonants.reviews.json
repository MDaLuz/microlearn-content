                "Es isch alles in Ornig.",
                "Alles isch Ornig"
              ],
              "answer": 2,
              "explanation": "Ornig = Ordnung."
            }
          ]
        },
        {
          "id": "ex2",
          "kind": "connect",
          "scenario": "Apply the rules to new words.",
          "questions": [
            {
              "type": "mcq",
              "prompt": "*Kasten* (cupboard) is most likely?",
              "options": [
                "Kasten",
                "Kaschte",
                "Chasten",
                "Chaschte"
              ],
              "answer": 3,
              "explanation": "k → ch, st → scht, -en → -e."
            },
            {
              "type": "mcq",
              "prompt": "*Konzert* is most likely?",
              "options": [
                "Konzärt",
                "Chonzärt",
                "Konzert",
                "Chonzert"
              ],
              "answer": 0,
              "explanation": "Loanword: k stays; short e → ä."
            },
            {
              "type": "self-check",
