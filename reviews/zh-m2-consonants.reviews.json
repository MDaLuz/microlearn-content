                "Wir kaufen Käse auf dem Markt.",
                "Mir chaufe Chäs uf de Markt."
              ],
              "answer": 0,
              "explanation": "ch, -ed, Märt."
            },
            {
              "type": "mcq",
              "prompt": "'A kilo of apples' is?",
              "options": [
                "Es Chilo Öpfel",
                "Es Kilo Öpfel",
                "Ein Kilo Äpfel",
                "Es Kilo Äpfle"
              ],
              "answer": 1,
              "explanation": "Loanword Kilo keeps k."
            },
            {
              "type": "self-check",
              "prompt": "Say 'Yesterday evening I bought cheese at the post office shop' with the rules from this block.",
              "modelAnswer": "Geschter am Abig han ich bi de Poscht Chäs kauft."
            }
          ]
        },
        {
          "id": "ex2",
          "kind": "connect",
          "scenario": "Sort words by their k.",
          "questions": [
            {
              "type": "mcq",
              "prompt": "Which word belongs with Chind?",
              "options": [
                "Kafi, a loanword",
                "Kino, a loanword",
                "Chäs",
                "Rugge, with gg"
              ],
              "answer": 2,
              "explanation": "Native initial k → ch."
            },
            {
              "type": "mcq",
              "prompt": "Which word shows scht at the end?",
              "options": [
                "Stadt",
                "Chuchi, with ch",
                "Kafi, with kch",
                "Wurscht"
              ],
              "answer": 3,
              "explanation": "st → scht at the end."
            }
          ]
        }
      ]
    },
    {
      "id": "rv-zh2-b2",
      "level": "block",
      "covers": [
        "zh2-l04-soft-strong",
