                "Merci vilmal, tschau!",
                "Äxgüsi, gärn gscheh!"
              ],
              "answer": 2,
              "explanation": "Informal thanks and goodbye."
            },
            {
              "type": "mcq",
              "prompt": "The host says *Schöne Abig!* Your reply?",
              "options": [
                "Gärn gscheh!",
                "Fröit mi!",
                "Wie meinsch?",
                "Merci, gliichfalls!"
              ],
              "answer": 3,
              "explanation": "Return the wish."
            }
          ]
        }
      ]
    },
