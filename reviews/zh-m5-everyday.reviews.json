                "Wann bin ich in der Waschküche dran?",
                "Wo isch d Wöschchuchi dra?"
              ],
              "answer": 0,
              "explanation": "dra sii."
            },
            {
              "type": "mcq",
              "prompt": "'Is this your bike?' (formal) is?",
              "options": [
                "Ghört das Velo dir?",
                "Ghört das Velo Ihne?",
                "Gehört das Fahrrad Ihnen?",
                "Isch das Velo Ihne gsii?"
              ],
              "answer": 1,
              "explanation": "Formal Ihne."
            }
          ]
        },
        {
          "id": "ex2",
          "kind": "connect",
          "scenario": "Planning a party.",
          "questions": [
            {
              "type": "mcq",
              "prompt": "What do you tell your neighbours?",
              "options": [
                "Am Samschtig isch es ruhig.",
                "Am Samstag gibt es etwas Lärm.",
                "Am Samschtig gits chli Lärm, mir händ es Fäscht.",
                "Am Sunntig händ mir Lärm gha."
              ],
              "answer": 2,
              "explanation": "Warn them in advance."
            },
            {
              "type": "mcq",
              "prompt": "What does *gits* mean?",
              "options": [
                "It goes",
                "Give it",
                "It's good",
                "There is (es git)"
              ],
              "answer": 3,
              "explanation": "es git = es gibt."
            }
          ]
        }
      ]
    },
