    {
      "id": "rv-zh5-l01",
      "level": "lesson",
      "covers": [
        "zh5-l01-shopping"
      ],
      "summary": {
        "title": "Shopping",
        "points": [
          "poschte = go shopping; de Lade = the shop.",
          "Checkout: Bruuched Si es Säckli? Mit Charte, bitte.",
          "in Aktion = on special offer.",
          "Härdöpfel, Rüebli, Anke: potatoes, carrots, butter."
        ]
      },
      "exercises": [
        {
          "id": "ex1",
          "kind": "apply",
          "scenario": "At the supermarket.",
          "questions": [
            {
              "type": "mcq",
              "prompt": "You can't find the milk. What do you ask?",
              "options": [
                "Wo find ich d Milch?",
                "Wo isch de Milch gsii?",
                "Wo finde ich die Milch?",
                "Händ Si Milch gha?"
              ],
              "answer": 0,
              "explanation": "Simple present question."
            },
            {
              "type": "mcq",
              "prompt": "The cashier asks *Bruuched Si es Säckli?* You have a bag. Reply?",
              "options": [
                "Ja, gärn, zwei Säckli.",
                "Nei, merci, ich ha eis.",
                "Nein danke, ich habe eine.",
                "Gärn gscheh, merci."
              ],
              "answer": 1,
              "explanation": "No thanks, I've got one."
            }
          ]
        },
        {
          "id": "ex2",
          "kind": "connect",
          "scenario": "Reading the shelf labels aloud.",
          "questions": [
            {
              "type": "mcq",
              "prompt": "What does *in Aktion* mean on a price tag?",
              "options": [
                "Sold out",
                "New product",
                "On special offer",
                "Organic"
              ],
              "answer": 2,
              "explanation": "Aktion = Angebot."
            },
            {
              "type": "mcq",
              "prompt": "What are *Rüebli*?",
              "options": [
                "Turnips",
                "Radishes",
                "Potatoes",
                "Carrots"
              ],
              "answer": 3,
              "explanation": "Swiss for Karotten."
            }
          ]
        }
      ]
    },
    {
      "id": "rv-zh5-l02",
      "level": "lesson",
      "covers": [
        "zh5-l02-bakery"
      ],
      "summary": {
        "title": "Bakery and café",
        "points": [
          "Gipfeli (croissant), Weggli (soft roll), Bürli (crusty roll), Zopf (Sunday loaf).",
          "Kafi Creme; e Schale = coffee with milk in Zurich.",
          "Zum Mitnäh? = to take away?",
          "Znüni (about 9) and Zvieri (about 4) are snacks."
        ]
      },
      "exercises": [
        {
          "id": "ex1",
          "kind": "apply",
          "scenario": "Saturday morning at the bakery.",
          "questions": [
            {
              "type": "mcq",
              "prompt": "'Two croissants, please' is?",
              "options": [
                "Zwei Gipfeli, bitte.",
                "Zwei Croissants, bitte schön.",
                "Zwei Gipfelis, bitte.",
                "Zwei Weggli, bitte."
              ],
              "answer": 0,
              "explanation": "Gipfeli; -li plural unchanged."
            },
            {
              "type": "mcq",
              "prompt": "You want coffee with milk in Zurich. You ask for?",
              "options": [
                "En Kafi Creme",
                "E Schale",
                "En Espresso",
                "En Zopf"
              ],
              "answer": 1,
              "explanation": "Schale = Milchkaffee."
            }
          ]
        },
        {
          "id": "ex2",
          "kind": "connect",
          "scenario": "The server asks *Zum Mitnäh?*",
          "questions": [
            {
              "type": "mcq",
              "prompt": "What does she want to know?",
              "options": [
                "Whether you want a bag",
                "Whether you'll pay by card",
                "Whether it's to take away",
                "Whether you want sugar"
              ],
              "answer": 2,
              "explanation": "mitnehmen."
            },
            {
              "type": "mcq",
              "prompt": "What's a *Zopf*?",
              "options": [
                "A croissant",
                "A cream cake",
                "A small roll",
                "A plaited Sunday loaf"
              ],
              "answer": 3,
              "explanation": "Braided bread."
            }
          ]
        }
      ]
    },
    {
      "id": "rv-zh5-l03",
      "level": "lesson",
      "covers": [
        "zh5-l03-restaurant"
      ],
      "summary": {
        "title": "Restaurant",
        "points": [
          "Weekday lunch: s Menü (set lunch).",
          "Say En Guete before eating; Proscht or Zum Wohl with drinks.",
          "Mir hetted gern en Tisch für zwei.",
          "Zale, bitte! Zäme oder separat? Tips are small."
        ]
      },
      "exercises": [
        {
          "id": "ex1",
          "kind": "apply",
          "scenario": "Lunch with a colleague.",
          "questions": [
            {
              "type": "mcq",
              "prompt": "'We'd like a table for two' is?",
              "options": [
                "Mir hetted gern en Tisch für zwei.",
                "Mir händ gern en Tisch für zwei gha.",
                "Wir hätten gern einen Tisch für zwei.",
                "Mir wänd zwei Tisch."
              ],
              "answer": 0,
              "explanation": "hetted gern."
            },
            {
              "type": "mcq",
              "prompt": "The food arrives. What do you say?",
              "options": [
                "Proscht!",
                "En Guete!",
                "Zale, bitte!",
                "Gärn gscheh!"
              ],
              "answer": 1,
              "explanation": "Before eating."
            }
          ]
        },
        {
          "id": "ex2",
          "kind": "connect",
          "scenario": "Paying the bill.",
          "questions": [
            {
              "type": "mcq",
              "prompt": "The waiter asks *Zäme oder separat?* You'll pay together. Reply?",
              "options": [
                "Mir zaled separat.",
                "Wir zahlen zusammen.",
                "Mir zaled zäme.",
                "Zäme isch guet gsii."
              ],
              "answer": 2,
              "explanation": "zale + -ed."
            },
            {
              "type": "mcq",
              "prompt": "What's *s Menü* at lunchtime?",
              "options": [
                "The menu card",
                "The dessert",
                "The bill",
                "The set lunch"
              ],
              "answer": 3,
              "explanation": "Daily set lunch."
            }
          ]
        }
      ]
    },
    {
      "id": "rv-zh5-l04",
      "level": "lesson",
      "covers": [
        "zh5-l04-gemeinde-transport"
      ],
      "summary": {
        "title": "Gemeinde and trains",
        "points": [
          "Register at the Gemeinde: Ich möcht mich aamälde.",
          "Billett, retour, Halbtax: Einisch Züri retour, mit Halbtax.",
          "Verspötig = delay; umstiige = change trains.",
          "Announcements are often High German; people speak dialect."
        ]
      },
      "exercises": [
        {
          "id": "ex1",
          "kind": "apply",
          "scenario": "At the station counter.",
          "questions": [
            {
              "type": "mcq",
              "prompt": "'One return to Zurich, half fare' is?",
              "options": [
                "Einisch Züri retour, mit Halbtax.",
                "Einmal Zürich hin und zurück, Halbtax.",
                "Es Billett uf Züri gsii.",
                "Zwei Züri retour, ohni Halbtax."
              ],
              "answer": 0,
              "explanation": "Einisch = einmal."
            },
            {
              "type": "mcq",
              "prompt": "You hear *De Zug hät Verspötig.* What's happening?",
              "options": [
                "The train is full",
                "The train is delayed",
                "The train is cancelled",
                "The train is on time"
              ],
              "answer": 1,
              "explanation": "Verspätung → Verspötig."
            }
          ]
        },
        {
          "id": "ex2",
          "kind": "connect",
          "scenario": "You've just moved.",
          "questions": [
            {
              "type": "mcq",
              "prompt": "What do you say at the Gemeinde counter?",
              "options": [
                "Ich möcht mich abmälde.",
                "Ich möchte mich anmelden.",
                "Ich möcht mich aamälde.",
                "Ich bi aamäldet gsii."
              ],
              "answer": 2,
              "explanation": "aa- = an-."
            },
            {
              "type": "mcq",
              "prompt": "'Where do I have to change?' is?",
              "options": [
                "Wo mues ich iistiige?",
                "Wo muss ich umsteigen?",
                "Wänn mues ich umstiige?",
                "Wo mues ich umstiige?"
              ],
              "answer": 3,
              "explanation": "umstiige."
            }
          ]
        }
      ]
    },
    {
      "id": "rv-zh5-l05",
      "level": "lesson",
      "covers": [
        "zh5-l05-doctor"
      ],
      "summary": {
        "title": "Doctor and pharmacy",
        "points": [
          "Ich möcht en Termin abmache.",
          "-weh for pains: Halsweh, Chopfweh, Buuchweh.",
          "Ich bruuch es Rezept; d Apothek = pharmacy.",
          "Switch to High German for medical detail; emergency 144."
        ]
      },
      "exercises": [
        {
          "id": "ex1",
          "kind": "apply",
          "scenario": "Calling your GP.",
          "questions": [
            {
              "type": "mcq",
              "prompt": "'I'd like to make an appointment' is?",
              "options": [
                "Ich möcht en Termin abmache.",
                "Ich möcht en Termin mache gsii.",
                "Ich möchte einen Termin vereinbaren.",
                "Ich ha en Termin abgmacht."
              ],
              "answer": 0,
              "explanation": "abmache."
            },
            {
              "type": "mcq",
              "prompt": "'I have a fever and a sore throat' is?",
              "options": [
                "Ich bi Fieber und Halsweh.",
                "Ich ha Fieber und Halsweh.",
                "Ich habe Fieber und Halsschmerzen.",
                "Ich ha Fieber und Chopfweh."
              ],
              "answer": 1,
              "explanation": "Halsweh."
            }
          ]
        },
        {
          "id": "ex2",
          "kind": "connect",
          "scenario": "At the pharmacy.",
          "questions": [
            {
              "type": "mcq",
              "prompt": "'I need a prescription' is?",
              "options": [
                "Ich brauche ein Rezept.",
                "Ich ha es Rezept bruucht.",
                "Ich bruuch es Rezept.",
                "Ich bruuch e Apothek."
              ],
              "answer": 2,
              "explanation": "bruuche."
            },
            {
              "type": "mcq",
              "prompt": "What's the Swiss ambulance number?",
              "options": [
                "117",
                "118",
                "112 only",
                "144"
              ],
              "answer": 3,
              "explanation": "117 police, 118 fire."
            }
          ]
        }
      ]
    },
    {
      "id": "rv-zh5-l06",
