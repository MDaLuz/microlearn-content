          "Guet Nacht, schlaf guet!"
        ]
      },
      "exercises": [
        {
          "id": "ex1",
          "kind": "apply",
          "scenario": "Evening routine.",
          "questions": [
            {
              "type": "mcq",
              "prompt": "'Food's ready!' is?",
