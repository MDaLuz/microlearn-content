              "answer": 0,
              "explanation": "parat = ready."
            },
            {
              "type": "mcq",
              "prompt": "'Off to bed, brush your teeth!' is?",
              "options": [
                "Ab ins Bett, Zähne putzen!",
                "Ab is Bett, Zähnli butze!",
                "Is Bett gaa, Zähnli gmacht!",
                "Ab is Bett, Zähnli ässe!"
              ],
              "answer": 1,
              "explanation": "butze."
            }
          ]
        },
        {
          "id": "ex2",
          "kind": "connect",
          "scenario": "Meal words.",
          "questions": [
            {
              "type": "mcq",
              "prompt": "What's *Zmittag*?",
              "options": [
                "Breakfast",
                "Dinner",
                "Lunch",
                "A snack"
              ],
              "answer": 2,
              "explanation": "Noon meal."
            },
            {
              "type": "mcq",
              "prompt": "'What's for dinner?' is?",
              "options": [
                "Was isch zum Zmorge?",
                "Was gibt es zum Abendessen?",
                "Was gits zum Znüni?",
                "Was gits zum Znacht?"
              ],
              "answer": 3,
              "explanation": "Znacht = dinner."
            }
          ]
        }
      ]
    },
