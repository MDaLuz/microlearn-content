              "prompt": "*Kei Ahnig, gäll?* means?",
              "options": [
                "No idea, right?",
                "No problem, OK?",
                "No time, sorry",
                "Not again!"
              ],
              "answer": 0,
              "explanation": "Ahnig, gäll."
            },
            {
              "type": "mcq",
              "prompt": "Best reaction to a colleague's good idea?",
              "options": [
                "Das isch huere guet!",
                "Das isch mega guet!",
                "So en Seich!",
                "Gopf!"
              ],
              "answer": 1,
              "explanation": "Safe intensifier."
            },
            {
              "type": "mcq",
              "prompt": "Someone from Basel says *Kind*. You'd say?",
              "options": [
                "Kind",
                "Kint",
                "Chind",
                "Chint"
              ],
              "answer": 2,
              "explanation": "Zurich ch."
            }
          ]
        },
        {
          "id": "ex2",
          "kind": "connect",
          "scenario": "Strategy.",
          "questions": [
            {
              "type": "mcq",
              "prompt": "Why paraphrase back?",
              "options": [
                "It ends the conversation",
                "It sounds more Swiss and more fluent",
                "It avoids dialect",
