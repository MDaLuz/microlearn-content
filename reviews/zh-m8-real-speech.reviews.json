      ],
      "summary": {
        "title": "Other dialects and listening",
        "points": [
          "Bern, Basel, Valais markers.",
          "Helvetisms are standard Swiss usage.",
          "Listening cycle: predict, catch, reverse, check."
        ]
      },
      "exercises": [
        {
          "id": "ex1",
          "kind": "apply",
          "scenario": "A meeting with colleagues from around Switzerland.",
          "questions": [
            {
              "type": "mcq",
              "prompt": "A colleague says *I weiss es nid.* Where from?",
              "options": [
                "Bern",
                "Zurich",
                "Basel",
                "Ticino"
              ],
              "answer": 0,
              "explanation": "i, nid."
            },
            {
              "type": "mcq",
              "prompt": "You didn't get his point. Check?",
              "options": [
                "Wasch los?",
                "Han ich das richtig verstande?",
                "Gopf!",
                "Ebe!"
              ],
              "answer": 1,
              "explanation": "Confirm."
            },
            {
              "type": "self-check",
              "prompt": "Paraphrase back: 'So you mean we start on Monday?'",
              "modelAnswer": "Du meinsch also, dass mir am Mäntig aafanged?"
            }
          ]
        },
        {
          "id": "ex2",
          "kind": "connect",
          "scenario": "Written Swiss German.",
          "questions": [
            {
              "type": "mcq",
              "prompt": "Which word is standard in Swiss newspapers?",
              "options": [
                "parken only",
                "Chuchi",
                "parkieren",
                "huere"
              ],
              "answer": 2,
              "explanation": "Helvetism."
            },
            {
              "type": "mcq",
              "prompt": "Which listening step uses your High German?",
              "options": [
                "Predict from context",
                "Catch stressed words",
                "Ask them to write every word down",
                "Reverse the sound rules"
              ],
              "answer": 3,
              "explanation": "Ziit → Zeit."
            }
          ]
        }
      ]
    },
