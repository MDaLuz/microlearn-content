          "Fillers: oder?, gäll, ebe, halt.",
          "Intensifiers by register: mega (safe) to huere (vulgar).",
          "Swearing: mild euphemisms vs strong forms."
        ]
      },
      "exercises": [
        {
          "id": "ex1",
          "kind": "apply",
          "scenario": "A lively dinner.",
          "questions": [
            {
              "type": "mcq",
              "prompt": "A friend says *Das isch mega guet, oder?* She wants?",
              "options": [
                "Your agreement",
                "An alternative",
                "The bill",
                "A repeat"
              ],
              "answer": 0,
              "explanation": "Tag question."
            },
            {
              "type": "mcq",
              "prompt": "Which word should you avoid with your neighbour's children?",
              "options": [
                "mega",
                "huere",
                "lässig",
                "Ebe"
              ],
              "answer": 1,
              "explanation": "Vulgar."
            },
            {
              "type": "self-check",
              "prompt": "React to good news in dialect, warmly but safely.",
              "modelAnswer": "Lässig! Das isch mega guet!"
            }
          ]
        },
        {
          "id": "ex2",
          "kind": "connect",
          "scenario": "Decoding a fast sentence.",
          "questions": [
            {
              "type": "mcq",
              "prompt": "*Wotsch öppis?* means?",
              "options": [
                "Where's something?",
                "Did you see something?",
                "Do you want something?",
                "Something's wrong"
              ],
              "answer": 2,
              "explanation": "wotsch = willst du."
            },
            {
              "type": "mcq",
              "prompt": "*Es isch halt eso* means?",
              "options": [
                "Stop that",
                "It's on hold",
                "Exactly",
                "That's just how it is"
              ],
              "answer": 3,
              "explanation": "halt = just."
            }
          ]
        }
      ]
    },
    {
      "id": "rv-zh8-b2",
      "level": "block",
      "covers": [
        "zh8-l05-other-dialects",
