    {
      "id": "rv-zh9-l01",
      "level": "lesson",
      "covers": [
        "zh9-l01-introduction"
      ],
      "summary": {
        "title": "Your introduction",
        "points": [
          "Five lines: name and origin, where and since when, work, family, why dialect.",
          "sit = since: sit drüü Jahr.",
          "imene = in a; dehei = at home.",
          "Say it aloud daily until it's automatic."
        ]
      },
      "exercises": [
        {
          "id": "ex1",
          "kind": "apply",
          "scenario": "Meeting a new neighbour.",
          "questions": [
            {
              "type": "mcq",
              "prompt": "'I've lived in the canton of Zurich for three years' is?",
              "options": [
                "Ich wohne sit drüü Jahr im Kanton Züri.",
                "Ich wohne seit drei Jahren im Kanton Zürich.",
                "Ich ha drüü Jahr im Kanton Züri gwohnt gsii.",
                "Ich wohne vor drüü Jahr z Züri."
              ],
              "answer": 0,
              "explanation": "sit + Jahr."
            },
            {
              "type": "mcq",
              "prompt": "'I work in an office' is?",
              "options": [
                "Ich schaffe in Büro.",
                "Ich schaffe imene Büro.",
                "Ich arbeite in einem Büro.",
                "Ich schaffe imene Büro gsii."
              ],
              "answer": 1,
              "explanation": "imene = in einem."
            }
          ]
        },
        {
          "id": "ex2",
          "kind": "connect",
          "scenario": "Why you're learning.",
          "questions": [
            {
              "type": "mcq",
              "prompt": "'… because this is home' is?",
              "options": [
                "… weil ich hier zu Hause bin.",
                "… wil ich dehei bi gsii.",
                "… wil ich da dehei bi.",
                "… wil da dehei isch ich."
              ],
              "answer": 2,
              "explanation": "Verb last after wil."
            },
            {
              "type": "mcq",
              "prompt": "What does *dehei* mean?",
              "options": [
                "Outside",
                "Today",
                "Everywhere",
                "At home"
              ],
              "answer": 3,
              "explanation": "zu Hause."
            }
          ]
        }
      ]
    },
    {
      "id": "rv-zh9-l02",
      "level": "lesson",
      "covers": [
        "zh9-l02-phone"
      ],
      "summary": {
        "title": "A phone call",
        "points": [
          "Open with your surname: Grüezi, da isch Meier.",
          "Reason: Ich lüüte aa wäge …",
          "Confirm: Das passt mer guet.",
          "Close with Uf Widerhööre."
        ]
      },
      "exercises": [
        {
          "id": "ex1",
          "kind": "apply",
          "scenario": "Calling the hairdresser.",
          "questions": [
            {
              "type": "mcq",
              "prompt": "How do you open?",
              "options": [
                "Grüezi, da isch Meier.",
                "Hallo, hier spricht Herr Meier.",
                "Grüezi, ich heisse gsii Meier.",
                "Meier, wer isch da?"
              ],
              "answer": 0,
              "explanation": "Da isch + surname."
            },
            {
              "type": "mcq",
              "prompt": "They offer Monday at ten, which suits you. Say?",
              "options": [
                "Das passt mir gut.",
                "Das passt mer guet.",
                "Das gaat nöd.",
                "Das isch no schwierig."
              ],
              "answer": 1,
              "explanation": "Suits me fine."
            }
          ]
        },
        {
          "id": "ex2",
          "kind": "connect",
          "scenario": "Ending the call.",
          "questions": [
            {
              "type": "mcq",
              "prompt": "Phone goodbye?",
              "options": [
                "Uf Widerluege!",
                "Schöne Fiirabig!",
                "Uf Widerhööre!",
                "Grüezi!"
              ],
              "answer": 2,
              "explanation": "hööre = hear."
            },
            {
              "type": "mcq",
              "prompt": "'I'm calling about an appointment' is?",
              "options": [
                "Ich rufe wegen eines Termins an.",
                "Ich lüüte wäge Termin gsii.",
                "Ich ha en Termin aaglüütet.",
                "Ich lüüte aa wäge emene Termin."
              ],
              "answer": 3,
              "explanation": "aalüüte + wäge."
            }
          ]
        }
      ]
    },
    {
      "id": "rv-zh9-l03",
      "level": "lesson",
      "covers": [
        "zh9-l03-dinner"
      ],
      "summary": {
        "title": "Dinner with neighbours",
        "points": [
          "Chömed ine! (plural imperative).",
          "Mir händ es Gschänkli mitbracht.",
          "Das isch mega fein! (fein = tasty).",
          "Merci für d Iiladig."
        ]
      },
      "exercises": [
        {
          "id": "ex1",
          "kind": "apply",
          "scenario": "Arriving at the neighbours'.",
          "questions": [
            {
              "type": "mcq",
              "prompt": "They open the door and say?",
              "options": [
                "Chömed ine!",
                "Chumm use!",
                "Kommt herein!",
                "Gömmer!"
              ],
              "answer": 0,
              "explanation": "Come in."
            },
            {
              "type": "mcq",
              "prompt": "You hand over flowers. Say?",
              "options": [
                "Wir haben ein Geschenk mitgebracht.",
                "Mir händ es Gschänkli mitbracht.",
                "Mir händ es Gschänk bringe.",
                "Mir bringed es Gschänkli gsii."
              ],
              "answer": 1,
              "explanation": "mitbracht."
            }
          ]
        },
        {
          "id": "ex2",
          "kind": "connect",
          "scenario": "During and after dinner.",
          "questions": [
            {
              "type": "mcq",
              "prompt": "Complimenting the food?",
              "options": [
                "Das isch huere fein!",
                "Das ist sehr lecker!",
                "Das isch mega fein!",
                "Das isch fein gsii gsii!"
              ],
              "answer": 2,
              "explanation": "mega fein."
            },
            {
              "type": "mcq",
              "prompt": "Thanking for the invitation?",
              "options": [
                "Danke für die Einladung.",
                "Merci für d Einladig.",
                "Merci für s Ässe gsii.",
                "Merci für d Iiladig."
              ],
              "answer": 3,
              "explanation": "ei → ii, -ung → -ig."
            }
          ]
        }
      ]
    },
    {
      "id": "rv-zh9-l04",
      "level": "lesson",
      "covers": [
        "zh9-l04-storytelling"
      ],
      "summary": {
        "title": "Storytelling",
        "points": [
          "Stories use the perfect throughout.",
          "zerscht, dänn, nachher, am Schluss.",
          "Geschter bin ich … gsii (linking n).",
          "Es isch öppis passiert = something happened."
        ]
      },
      "exercises": [
        {
          "id": "ex1",
          "kind": "apply",
          "scenario": "Telling your weekend.",
          "questions": [
            {
              "type": "mcq",
              "prompt": "'Yesterday I was in Zurich' is?",
              "options": [
                "Geschter bin ich z Züri gsii.",
                "Gestern war ich in Zürich.",
                "Geschter war ich z Züri.",
                "Geschter bi ich z Züri gange gsii."
              ],
              "answer": 0,
              "explanation": "Perfect; bin before ich."
            },
            {
              "type": "mcq",
              "prompt": "'First we had something to eat' is?",
              "options": [
                "Zuerst assen wir etwas.",
                "Zerscht hämmer öppis ggässe.",
                "Zerscht händ mir öppis ässe.",
                "Zerscht hämmer nüt ggässe."
              ],
              "answer": 1,
              "explanation": "hämmer + ggässe."
            }
          ]
        },
        {
          "id": "ex2",
          "kind": "connect",
          "scenario": "Story frame.",
          "questions": [
            {
              "type": "mcq",
              "prompt": "Which word means 'in the end'?",
              "options": [
                "zerscht",
                "dänn",
                "am Schluss",
                "nachher"
              ],
              "answer": 2,
              "explanation": "Final step."
            },
            {
              "type": "mcq",
              "prompt": "Why *bin ich* rather than *bi ich*?",
              "options": [
                "It's the plural",
                "It's Bern German",
                "It's a mistake in the course",
                "Linking n before a vowel"
              ],
              "answer": 3,
              "explanation": "Linking n."
            }
          ]
        }
      ]
    },
